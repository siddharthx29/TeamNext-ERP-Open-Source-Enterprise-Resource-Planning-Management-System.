# ============================================================
# TeamNext ERP - Enterprise Environment Configuration Template
# Copy this file to .env and fill in your actual production values
# NEVER commit your actual .env file to public version control!
# ============================================================

# Environment Profile & Operational Mode: production, staging, development, or testing
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=generate-a-secure-random-64-character-key-for-production

# Allowed Hostnames (Comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com,.onrender.com

# ============================================================
# Persistent Database Configuration
# ============================================================
# 1. Option A: Full Connection URL (12-Factor App Standard)
# Supported schemes: postgresql://, postgres://, mysql://, sqlite:///
DATABASE_URL=postgresql://teamnext:secure_db_password@your-db-host.com:5432/teamnext

# 2. Option B: Individual Database Parameters (Used if DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=teamnext
DB_USER=teamnext
DB_PASSWORD=secure_db_password
DB_HOST=your-db-host.com
DB_PORT=5432

# Connection Pooling & Health Checks (Seconds to retain connection, 0-600)
DB_CONN_MAX_AGE=600

# Production Persistence Safeguard:
# If set to False (default), the app raises a critical alert if SQLite is detected in production.
# Only set to True if SQLite is intentionally mounted on a permanent persistent Docker volume.
ALLOW_SQLITE_IN_PRODUCTION=False

# ============================================================
# Automated Database Backups & Retention Policies
# ============================================================
# Directory where backups and manifest catalog are stored
BACKUP_DIR=backups

# Retention Policy Windows (Automatic pruning of expired archives)
BACKUP_RETENTION_DAYS=30
WEEKLY_BACKUP_RETENTION=12
MONTHLY_BACKUP_RETENTION=12

# Optional Offsite Cloud Storage (AWS S3, Google Cloud Storage, or MinIO)
# When configured, backups are automatically replicated offsite after integrity verification.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=

# ============================================================
# Transactional Email Service (Brevo / SMTP)
# ============================================================
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username@example.com
EMAIL_HOST_PASSWORD=your-smtp-api-key-or-app-password
DEFAULT_FROM_EMAIL=notifications@your-domain.com

# Brevo HTTP API Key (Optional fallback for restricted SMTP environments)
BREVO_API_KEY=your-brevo-api-v3-key
