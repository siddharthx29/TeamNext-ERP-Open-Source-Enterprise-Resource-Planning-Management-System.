# ============================================================
# TeamNext ERP - Environment Configuration Template
# Copy this file to .env and fill in your actual production values
# NEVER commit your actual .env file to public version control!
# ============================================================

# Django Core Security
SECRET_KEY=your-super-secret-key-replace-this-in-production
DEBUG=False

# Allowed Hostnames (Comma separated or standard Django list)
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com,.onrender.com

# Database Connection (Leave empty to use SQLite by default)
# Example for PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# Email Service Configuration (Brevo / SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username@example.com
EMAIL_HOST_PASSWORD=your-smtp-api-key-or-app-password
DEFAULT_FROM_EMAIL=notifications@your-domain.com

# Brevo HTTP API Key (Optional: for Render free plan HTTP dispatch)
BREVO_API_KEY=your-brevo-api-v3-key
